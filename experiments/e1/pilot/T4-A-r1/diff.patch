diff --git a/src/modules/front-desk/application/visits.service.spec.ts b/src/modules/front-desk/application/visits.service.spec.ts
new file mode 100644
index 0000000..a8feddf
--- /dev/null
+++ b/src/modules/front-desk/application/visits.service.spec.ts
@@ -0,0 +1,70 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { OverdueBalanceQuery } from '@/contracts/billing.queries';
+import { FrontDeskEvents } from '@/contracts/front-desk.events';
+import { FixedClock } from '@/shared-kernel';
+import { Visit } from '../domain/visit';
+import { OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const stored = this.items.get(appointmentId);
+    return stored ? Visit.restore(stored.toSnapshot()) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.toSnapshot().appointmentId, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+class StubOverdueBalanceQuery extends OverdueBalanceQuery {
+  readonly overdue = new Set<string>();
+
+  async hasOverdueBalance(personId: string) {
+    return this.overdue.has(personId);
+  }
+}
+
+describe('VisitsService.checkIn', () => {
+  let repository: InMemoryVisitRepository;
+  let overdue: StubOverdueBalanceQuery;
+  let events: EventEmitter2;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    repository = new InMemoryVisitRepository();
+    overdue = new StubOverdueBalanceQuery();
+    events = new EventEmitter2();
+    service = new VisitsService(repository, overdue, new FixedClock(new Date('2026-03-02T09:50:00Z')), events);
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-03-02T10:00:00Z'),
+    });
+  });
+
+  it('checks the visitor in when there is no overdue balance', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('refuses the check-in, persists nothing and publishes nothing when the visitor has an overdue balance', async () => {
+    overdue.overdue.add('person-1');
+    const published: unknown[] = [];
+    events.on(FrontDeskEvents.VisitorCheckedIn, (e: unknown) => published.push(e));
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+
+    expect(repository.items.get('appt-1')?.status).toBe('EXPECTED');
+    expect(published).toHaveLength(0);
+  });
+});
