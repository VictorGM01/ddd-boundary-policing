+import { Injectable } from '@nestjs/common';
+import { OnEvent } from '@nestjs/event-emitter';
+import { BillingEvents, InvoiceIssued } from '@/contracts/billing.events';
+import { VisitsService } from '../application/visits.service';
+
+@Injectable()
+export class BillingEventsListener {
+  constructor(private readonly visits: VisitsService) {}
+
+  @OnEvent(BillingEvents.InvoiceIssued)
+  async onInvoiceIssued(event: InvoiceIssued): Promise<void> {
+    await this.visits.trackOpenInvoice({
+      invoiceId: event.invoiceId,
+      personId: event.personId,
+      issuedAt: new Date(event.issuedAt),
+    });
+  }
+}
diff --git a/src/modules/front-desk/application/visits.service.spec.ts b/src/modules/front-desk/application/visits.service.spec.ts
new file mode 100644
index 0000000..4c66930
--- /dev/null
+++ b/src/modules/front-desk/application/visits.service.spec.ts
@@ -0,0 +1,90 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FixedClock, PersonId } from '@/shared-kernel';
+import { OpenInvoiceRepository } from '../domain/open-invoice.repository';
+import { Visit } from '../domain/visit';
+import { OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items: Visit[] = [];
+
+  async findByAppointmentId(appointmentId: string) {
+    return this.items.find((v) => v.toSnapshot().appointmentId === appointmentId) ?? null;
+  }
+
+  async findCheckedIn() {
+    return this.items.filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async save(visit: Visit) {
+    if (!this.items.includes(visit)) {
+      this.items.push(visit);
+    }
+  }
+}
+
+class InMemoryOpenInvoiceRepository extends OpenInvoiceRepository {
+  readonly items: { invoiceId: string; personId: PersonId; issuedAt: Date }[] = [];
+
+  async record(invoice: { invoiceId: string; personId: PersonId; issuedAt: Date }) {
+    this.items.push(invoice);
+  }
+
+  async existsIssuedBefore(personId: PersonId, cutoff: Date) {
+    return this.items.some((i) => i.personId === personId && i.issuedAt.getTime() < cutoff.getTime());
+  }
+}
+
+describe('VisitsService.checkIn', () => {
+  const now = new Date('2026-03-02T09:50:00Z');
+  const daysAgo = (days: number, extraMs = 0) => new Date(now.getTime() - days * 86_400_000 - extraMs);
+
+  let visits: InMemoryVisitRepository;
+  let openInvoices: InMemoryOpenInvoiceRepository;
+  let events: EventEmitter2;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    visits = new InMemoryVisitRepository();
+    openInvoices = new InMemoryOpenInvoiceRepository();
+    events = new EventEmitter2();
+    service = new VisitsService(visits, openInvoices, new FixedClock(now), events);
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-03-02T10:00:00Z'),
+    });
+  });
+
+  it('checks in a visitor without open invoices', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('refuses the check-in when an invoice is older than 30 days', async () => {
+    await service.trackOpenInvoice({ invoiceId: 'inv-1', personId: 'person-1', issuedAt: daysAgo(30, 1) });
+    const checkedIn = jest.fn();
+    events.on('front-desk.visitor-checked-in', checkedIn);
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+
+    expect(visits.items[0].status).toBe('EXPECTED');
+    expect(checkedIn).not.toHaveBeenCalled();
+  });
+
+  it('allows the check-in when the invoice is exactly 30 days old or newer', async () => {
+    await service.trackOpenInvoice({ invoiceId: 'inv-1', personId: 'person-1', issuedAt: daysAgo(30) });
+    await service.trackOpenInvoice({ invoiceId: 'inv-2', personId: 'person-1', issuedAt: daysAgo(5) });
+
+    await expect(service.checkIn('appt-1')).resolves.toBeDefined();
+  });
+
+  it('ignores overdue invoices of other visitors', async () => {
+    await service.trackOpenInvoice({ invoiceId: 'inv-1', personId: 'person-2', issuedAt: daysAgo(90) });
+
+    await expect(service.checkIn('appt-1')).resolves.toBeDefined();
+  });
+});
