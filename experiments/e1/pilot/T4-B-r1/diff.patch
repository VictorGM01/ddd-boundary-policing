@@ -0,0 +1,26 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { PersonId } from '@/shared-kernel';
+import { OpenInvoiceRepository } from '../domain/open-invoice.repository';
+
+@Injectable()
+export class PrismaOpenInvoiceRepository extends OpenInvoiceRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async record(invoice: { invoiceId: string; personId: PersonId; issuedAt: Date }): Promise<void> {
+    await this.prisma.frontDeskOpenInvoice.upsert({
+      where: { invoiceId: invoice.invoiceId },
+      create: invoice,
+      update: invoice,
+    });
+  }
+
+  async existsIssuedBefore(personId: PersonId, cutoff: Date): Promise<boolean> {
+    const count = await this.prisma.frontDeskOpenInvoice.count({
+      where: { personId, issuedAt: { lt: cutoff } },
+    });
+    return count > 0;
+  }
+}
