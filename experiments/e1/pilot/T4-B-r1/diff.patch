index 0000000..88d19d9
--- /dev/null
+++ b/src/modules/front-desk/domain/overdue-balance.ts
@@ -0,0 +1,8 @@
+export const OVERDUE_AFTER_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** Invoices issued strictly before this instant are overdue. */
+export function overdueCutoff(now: Date): Date {
+  return new Date(now.getTime() - OVERDUE_AFTER_DAYS * DAY_MS);
+}
