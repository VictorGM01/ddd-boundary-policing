@@ -0,0 +1,24 @@
+import { Injectable } from '@nestjs/common';
+import type { PractitionerNoShowSummary } from '../domain/no-show-report';
+import { NoShowReportRepository } from '../domain/no-show-report.repository';
+import { InvalidReportPeriodError } from '../domain/reporting.errors';
+
+@Injectable()
+export class NoShowReportService {
+  constructor(private readonly report: NoShowReportRepository) {}
+
+  async noShowsAppointment(input: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void> {
+    await this.report.recordNoShow(input);
+  }
+
+  async feeCharged(input: { appointmentId: string; amountCents: number }): Promise<void> {
+    await this.report.recordFee(input);
+  }
+
+  async byPractitioner(from: Date, to: Date): Promise<PractitionerNoShowSummary[]> {
+    if (from.getTime() >= to.getTime()) {
+      throw new InvalidReportPeriodError();
+    }
+    return this.report.summarizeByPractitioner(from, to);
+  }
+}
