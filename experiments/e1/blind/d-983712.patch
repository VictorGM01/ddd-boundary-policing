+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { NoShowReportService } from '../application/no-show-report.service';
+
+@Controller('reports')
+export class ReportsController {
+  constructor(private readonly report: NoShowReportService) {}
+
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const fromDate = new Date(from ?? '');
+    const toDate = new Date(to ?? '');
+    if (Number.isNaN(fromDate.getTime()) || Number.isNaN(toDate.getTime())) {
+      throw new BadRequestException('from and to are required ISO-8601 dates');
+    }
+    return this.report.byPractitioner(fromDate, toDate);
+  }
+}
diff --git a/src/modules/reporting/application/no-show-report.service.spec.ts b/src/modules/reporting/application/no-show-report.service.spec.ts
new file mode 100644
index 0000000..605f35e
--- /dev/null
+++ b/src/modules/reporting/application/no-show-report.service.spec.ts
@@ -0,0 +1,91 @@
+import type { PractitionerNoShowSummary } from '../domain/no-show-report';
+import { NoShowReportRepository } from '../domain/no-show-report.repository';
+import { InvalidReportPeriodError } from '../domain/reporting.errors';
+import { NoShowReportService } from './no-show-report.service';
+
+interface Row {
+  practitionerId?: string;
+  startsAt?: Date;
+  feeCents: number;
+}
+
+class InMemoryNoShowReportRepository extends NoShowReportRepository {
+  readonly rows = new Map<string, Row>();
+
+  async recordNoShow(input: { appointmentId: string; practitionerId: string; startsAt: Date }) {
+    const row = this.rows.get(input.appointmentId) ?? { feeCents: 0 };
+    this.rows.set(input.appointmentId, { ...row, practitionerId: input.practitionerId, startsAt: input.startsAt });
+  }
+
+  async recordFee(input: { appointmentId: string; amountCents: number }) {
+    const row = this.rows.get(input.appointmentId) ?? { feeCents: 0 };
+    this.rows.set(input.appointmentId, { ...row, feeCents: input.amountCents });
+  }
+
+  async summarizeByPractitioner(from: Date, to: Date) {
+    const byPractitioner = new Map<string, PractitionerNoShowSummary>();
+    for (const row of this.rows.values()) {
+      if (!row.practitionerId || !row.startsAt || row.startsAt < from || row.startsAt >= to) continue;
+      const current = byPractitioner.get(row.practitionerId) ?? {
+        practitionerId: row.practitionerId,
+        noShows: 0,
+        feesCents: 0,
+      };
+      current.noShows += 1;
+      current.feesCents += row.feeCents;
+      byPractitioner.set(row.practitionerId, current);
+    }
+    return [...byPractitioner.values()];
+  }
+}
+
+describe('NoShowReportService', () => {
+  const from = new Date('2026-03-01T00:00:00Z');
+  const to = new Date('2026-04-01T00:00:00Z');
+  let service: NoShowReportService;
+
+  beforeEach(() => {
+    service = new NoShowReportService(new InMemoryNoShowReportRepository());
+  });
+
+  it('counts no-shows and sums fees per practitioner', async () => {
+    await service.noShowsAppointment({ appointmentId: 'a-1', practitionerId: 'dr-a', startsAt: new Date('2026-03-02T10:00:00Z') });
+    await service.feeCharged({ appointmentId: 'a-1', amountCents: 10_000 });
+    await service.noShowsAppointment({ appointmentId: 'a-2', practitionerId: 'dr-a', startsAt: new Date('2026-03-03T10:00:00Z') });
+    await service.feeCharged({ appointmentId: 'a-2', amountCents: 10_000 });
+    await service.noShowsAppointment({ appointmentId: 'a-3', practitionerId: 'dr-b', startsAt: new Date('2026-03-04T10:00:00Z') });
+    await service.feeCharged({ appointmentId: 'a-3', amountCents: 10_000 });
+
+    expect(await service.byPractitioner(from, to)).toEqual([
+      { practitionerId: 'dr-a', noShows: 2, feesCents: 20_000 },
+      { practitionerId: 'dr-b', noShows: 1, feesCents: 10_000 },
+    ]);
+  });
+
+  it('is independent of whether the fee or the no-show arrives first', async () => {
+    await service.feeCharged({ appointmentId: 'a-1', amountCents: 10_000 });
+    expect(await service.byPractitioner(from, to)).toEqual([]);
+
+    await service.noShowsAppointment({ appointmentId: 'a-1', practitionerId: 'dr-a', startsAt: new Date('2026-03-02T10:00:00Z') });
+
+    expect(await service.byPractitioner(from, to)).toEqual([{ practitionerId: 'dr-a', noShows: 1, feesCents: 10_000 }]);
+  });
+
+  it('counts a no-show whose fee has not been charged with zero fees', async () => {
+    await service.noShowsAppointment({ appointmentId: 'a-1', practitionerId: 'dr-a', startsAt: new Date('2026-03-02T10:00:00Z') });
+
+    expect(await service.byPractitioner(from, to)).toEqual([{ practitionerId: 'dr-a', noShows: 1, feesCents: 0 }]);
+  });
+
+  it('includes the start of the period and excludes its end', async () => {
+    await service.noShowsAppointment({ appointmentId: 'a-1', practitionerId: 'dr-a', startsAt: from });
+    await service.noShowsAppointment({ appointmentId: 'a-2', practitionerId: 'dr-a', startsAt: to });
+
+    expect(await service.byPractitioner(from, to)).toEqual([{ practitionerId: 'dr-a', noShows: 1, feesCents: 0 }]);
+  });
+
+  it('rejects a period that does not start before it ends', async () => {
+    await expect(service.byPractitioner(to, from)).rejects.toThrow(InvalidReportPeriodError);
+    await expect(service.byPractitioner(from, from)).rejects.toThrow(InvalidReportPeriodError);
+  });
+});
diff --git a/src/modules/reporting/application/no-show-report.service.ts b/src/modules/reporting/application/no-show-report.service.ts
