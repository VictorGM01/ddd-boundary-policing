diff --git a/src/modules/billing/domain/follow-up-policy.ts b/src/modules/billing/domain/follow-up-policy.ts
new file mode 100644
index 0000000..37b023e
--- /dev/null
+++ b/src/modules/billing/domain/follow-up-policy.ts
@@ -0,0 +1,9 @@
+export const CONSULTATION_CODE = '10101012';
+export const FOLLOW_UP_WINDOW_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** Start of the window in which a charged consultation makes a new consultation a free follow-up. */
+export function followUpWindowStart(now: Date): Date {
+  return new Date(now.getTime() - FOLLOW_UP_WINDOW_DAYS * DAY_MS);
+}
