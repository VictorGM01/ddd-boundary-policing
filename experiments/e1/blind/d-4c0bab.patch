+  /** Refunds the no-show fee of an appointment. Idempotent; a no-op when no fee was charged. */
+  async refundNoShow(input: { appointmentId: string }): Promise<Invoice | null> {
+    const invoice = await this.invoices.findBySource({ type: 'NO_SHOW', id: input.appointmentId });
+    if (!invoice || invoice.status === 'REFUNDED') {
+      return invoice;
+    }
+    invoice.refund(this.clock.now());
+    await this.invoices.save(invoice);
+    return invoice;
