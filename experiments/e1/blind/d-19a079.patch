index 0000000..15a4eb4
--- /dev/null
+++ b/src/modules/billing/domain/follow-up-policy.ts
@@ -0,0 +1,18 @@
+import { OFFICE_CONSULTATION_CODE } from './price-list';
+
+export const FOLLOW_UP_WINDOW_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * An office consultation is not charged again when the same payer already paid for one with the
+ * same practitioner within the last 30 days. Only charged consultations open a window, so waived
+ * follow-ups never extend it.
+ */
+export const FollowUpPolicy = {
+  waivedCode: OFFICE_CONSULTATION_CODE,
+
+  windowFor(servicedAt: Date): { from: Date; to: Date } {
+    return { from: new Date(servicedAt.getTime() - FOLLOW_UP_WINDOW_DAYS * DAY_MS), to: servicedAt };
+  },
+} as const;
