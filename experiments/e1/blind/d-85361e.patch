@@ -0,0 +1,31 @@
+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { InvoicingService } from '../application/invoicing.service';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+@Controller('reports/no-shows')
+export class NoShowReportController {
+  constructor(private readonly invoicing: InvoicingService) {}
+
+  @Get()
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const start = parseInstant('from', from, 'start');
+    const end = parseInstant('to', to, 'end');
+    if (start > end) {
+      throw new BadRequestException('from must not be after to');
+    }
+    return this.invoicing.noShowFeesByPractitioner(start, end);
+  }
+}
+
+/** Accepts an ISO timestamp, or a plain date (YYYY-MM-DD) meaning the start or the end of that UTC day. */
+function parseInstant(name: string, value: string | undefined, edge: 'start' | 'end'): Date {
+  if (!value) {
+    throw new BadRequestException(`${name} is required`);
+  }
+  const date = new Date(DATE_ONLY.test(value) && edge === 'end' ? `${value}T23:59:59.999Z` : value);
+  if (Number.isNaN(date.getTime())) {
+    throw new BadRequestException(`${name} must be an ISO date or timestamp`);
+  }
+  return date;
+}
