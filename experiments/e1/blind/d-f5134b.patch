diff --git a/src/modules/front-desk/domain/waiting-metrics.ts b/src/modules/front-desk/domain/waiting-metrics.ts
new file mode 100644
index 0000000..00f592b
--- /dev/null
+++ b/src/modules/front-desk/domain/waiting-metrics.ts
@@ -0,0 +1,18 @@
+import type { Visit } from './visit';
+
+export class WaitingMetrics {
+  private constructor(
+    readonly servedCount: number,
+    readonly averageWaitingSeconds: number | null,
+    readonly maxWaitingSeconds: number | null,
+  ) {}
+
+  static of(visits: readonly Visit[]): WaitingMetrics {
+    const waits = visits.map((visit) => visit.waitingMs).filter((ms): ms is number => ms !== null);
+    if (waits.length === 0) {
+      return new WaitingMetrics(0, null, null);
+    }
+    const average = waits.reduce((sum, ms) => sum + ms, 0) / waits.length;
+    return new WaitingMetrics(waits.length, Math.round(average / 1000), Math.round(Math.max(...waits) / 1000));
+  }
+}
