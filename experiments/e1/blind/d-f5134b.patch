@@ -0,0 +1,77 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FixedClock } from '@/shared-kernel';
+import { Visit } from '../domain/visit';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    return this.items.get(appointmentId) ?? null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async findServedCheckedInBetween(from: Date, to: Date) {
+    return [...this.items.values()].filter((v) => {
+      const { checkedInAt, servedAt } = v.toSnapshot();
+      return servedAt !== null && checkedInAt !== null && checkedInAt >= from && checkedInAt < to;
+    });
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.toSnapshot().appointmentId, visit);
+  }
+}
+
+describe('VisitsService waiting metrics', () => {
+  let clock: FixedClock;
+  let service: VisitsService;
+
+  beforeEach(() => {
+    clock = new FixedClock(new Date('2026-03-02T08:00:00Z'));
+    service = new VisitsService(new InMemoryVisitRepository(), clock, new EventEmitter2());
+  });
+
+  async function visit(appointmentId: string, checkIn: string, servedAt?: string) {
+    await service.expectVisitor({
+      appointmentId,
+      personId: `person-${appointmentId}`,
+      practitionerId: 'dr-1',
+      expectedAt: new Date(checkIn),
+    });
+    clock.set(new Date(checkIn));
+    await service.checkIn(appointmentId);
+    if (servedAt) {
+      await service.markServed(appointmentId, new Date(servedAt));
+    }
+  }
+
+  it('averages and maximizes the waiting time of visitors served today', async () => {
+    await visit('a', '2026-03-02T09:00:00Z', '2026-03-02T09:10:00Z');
+    await visit('b', '2026-03-02T09:30:00Z', '2026-03-02T10:00:00Z');
+    await visit('c', '2026-03-02T10:30:00Z');
+    clock.set(new Date('2026-03-02T12:00:00Z'));
+
+    const metrics = await service.waitingMetricsToday();
+
+    expect(metrics).toMatchObject({ servedCount: 2, averageWaitingSeconds: 1200, maxWaitingSeconds: 1800 });
+  });
+
+  it('excludes visitors who checked in on another day', async () => {
+    await visit('old', '2026-03-01T23:50:00Z', '2026-03-02T00:20:00Z');
+    await visit('new', '2026-03-02T09:00:00Z', '2026-03-02T09:05:00Z');
+    clock.set(new Date('2026-03-02T12:00:00Z'));
+
+    const metrics = await service.waitingMetricsToday();
+
+    expect(metrics).toMatchObject({ servedCount: 1, averageWaitingSeconds: 300, maxWaitingSeconds: 300 });
+  });
+
+  it('ignores an encounter start for an unknown appointment', async () => {
+    await expect(service.markServed('missing', new Date())).resolves.toBeUndefined();
+  });
+});
