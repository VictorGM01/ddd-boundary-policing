+++ b/src/modules/front-desk/domain/waiting-time-metrics.ts
@@ -0,0 +1,19 @@
+import type { Visit } from './visit';
+
+export class WaitingTimeMetrics {
+  private constructor(
+    readonly count: number,
+    readonly averageMs: number | null,
+    readonly maxMs: number | null,
+  ) {}
+
+  /** Considers only visitors whose consultation has already started; those still waiting have no final waiting time. */
+  static of(visits: readonly Visit[]): WaitingTimeMetrics {
+    const waits = visits.map((visit) => visit.waitingTimeMs).filter((ms): ms is number => ms !== null);
+    if (waits.length === 0) {
+      return new WaitingTimeMetrics(0, null, null);
+    }
+    const total = waits.reduce((sum, ms) => sum + ms, 0);
+    return new WaitingTimeMetrics(waits.length, total / waits.length, Math.max(...waits));
+  }
+}
