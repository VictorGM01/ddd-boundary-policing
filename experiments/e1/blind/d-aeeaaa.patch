+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { ClinicalEvents, EncounterStarted } from '@/contracts/clinical.events';
+import { FixedClock } from '@/shared-kernel';
+import { Encounter } from '../domain/encounter';
+import { EncounterRepository } from '../domain/encounter.repository';
+import { EncountersService } from './encounters.service';
+
+class InMemoryEncounterRepository extends EncounterRepository {
+  readonly items = new Map<string, Encounter>();
+
+  async findById(id: string) {
+    return this.items.get(id) ?? null;
+  }
+
+  async findByAppointmentId(appointmentId: string) {
+    return [...this.items.values()].find((e) => e.toSnapshot().appointmentId === appointmentId) ?? null;
+  }
+
+  async save(encounter: Encounter) {
+    this.items.set(encounter.id, Encounter.restore(encounter.toSnapshot()));
+  }
+}
+
+describe('EncountersService', () => {
+  it('publishes EncounterStarted with the start time when an encounter starts', async () => {
+    const clock = new FixedClock(new Date('2026-03-02T10:05:00Z'));
+    const repository = new InMemoryEncounterRepository();
+    const events = new EventEmitter2();
+    const published: EncounterStarted[] = [];
+    events.on(ClinicalEvents.EncounterStarted, (e: EncounterStarted) => published.push(e));
+    const service = new EncountersService(repository, clock, events);
+    await service.registerArrival({
+      appointmentId: 'appt-1',
+      patientId: 'person-1',
+      practitionerId: 'dr-1',
+      arrivedAt: new Date('2026-03-02T09:50:00Z'),
+    });
+    const encounter = await service.findByAppointment('appt-1');
+
+    await service.start(encounter.id);
+
+    expect(published).toEqual([
+      expect.objectContaining({ appointmentId: 'appt-1', startedAt: '2026-03-02T10:05:00.000Z' }),
+    ]);
+    expect(Object.keys(published[0]).sort()).toEqual(['appointmentId', 'eventId', 'occurredAt', 'startedAt']);
+  });
+});
