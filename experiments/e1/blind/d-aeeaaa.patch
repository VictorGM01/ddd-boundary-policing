+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FixedClock } from '@/shared-kernel';
+import { Visit } from '../domain/visit';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    return [...this.items.values()].find((v) => v.toSnapshot().appointmentId === appointmentId) ?? null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async findCheckedInBetween(from: Date, to: Date) {
+    return (await this.findCheckedIn()).filter((v) => {
+      const at = v.checkedInAt as Date;
+      return at >= from && at < to;
+    });
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.id, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+describe('VisitsService waiting time metrics', () => {
+  const clock = new FixedClock(new Date('2026-03-02T12:00:00Z'));
+  let repository: InMemoryVisitRepository;
+  let service: VisitsService;
+
+  beforeEach(() => {
+    repository = new InMemoryVisitRepository();
+    service = new VisitsService(repository, clock, new EventEmitter2());
+  });
+
+  async function arrive(appointmentId: string, checkedInAt: string, startedAt?: string) {
+    await service.expectVisitor({
+      appointmentId,
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date(checkedInAt),
+    });
+    clock.set(new Date(checkedInAt));
+    await service.checkIn(appointmentId);
+    if (startedAt) {
+      await service.recordConsultationStart(appointmentId, new Date(startedAt));
+    }
+    clock.set(new Date('2026-03-02T12:00:00Z'));
+  }
+
+  it('reports the average and maximum waiting time of today', async () => {
+    await arrive('a', '2026-03-02T09:00:00Z', '2026-03-02T09:10:00Z');
+    await arrive('b', '2026-03-02T09:20:00Z', '2026-03-02T09:50:00Z');
+    await arrive('c', '2026-03-02T11:00:00Z');
+
+    const metrics = await service.todayWaitingTimeMetrics();
+
+    expect(metrics.count).toBe(2);
+    expect(metrics.averageMs).toBe(20 * 60_000);
+    expect(metrics.maxMs).toBe(30 * 60_000);
+  });
+
+  it('leaves out visitors who checked in on another day', async () => {
+    await arrive('yesterday', '2026-03-01T09:00:00Z', '2026-03-01T11:00:00Z');
+    await arrive('today', '2026-03-02T09:00:00Z', '2026-03-02T09:05:00Z');
+
+    const metrics = await service.todayWaitingTimeMetrics();
+
+    expect(metrics.count).toBe(1);
+    expect(metrics.maxMs).toBe(5 * 60_000);
+  });
+
+  it('ignores a consultation start for an unknown appointment', async () => {
+    await expect(service.recordConsultationStart('nope', new Date())).resolves.toBeUndefined();
+  });
+});
