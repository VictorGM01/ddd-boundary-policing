@@ -0,0 +1,21 @@
+import type { Visit } from './visit';
+
+export interface QueueMetrics {
+  /** Visits checked in today whose encounter has already started. */
+  attended: number;
+  averageWaitingSeconds: number | null;
+  maxWaitingSeconds: number | null;
+}
+
+export function computeQueueMetrics(visits: readonly Visit[]): QueueMetrics {
+  const waits = visits.map((visit) => visit.waitingTimeMs).filter((ms): ms is number => ms !== null);
+  if (waits.length === 0) {
+    return { attended: 0, averageWaitingSeconds: null, maxWaitingSeconds: null };
+  }
+  const total = waits.reduce((sum, ms) => sum + ms, 0);
+  return {
+    attended: waits.length,
+    averageWaitingSeconds: Math.round(total / waits.length / 1000),
+    maxWaitingSeconds: Math.round(Math.max(...waits) / 1000),
+  };
+}
