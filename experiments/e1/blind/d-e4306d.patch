index 0000000..c8feb0f
--- /dev/null
+++ b/src/modules/billing/domain/follow-up-policy.ts
@@ -0,0 +1,14 @@
+import { CONSULTATION_CODE } from './price-list';
+
+export const FOLLOW_UP_WINDOW_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** The consultation is not charged again when the same payer already paid for one with the same practitioner within the window. */
+export const FollowUpPolicy = {
+  consultationCode: CONSULTATION_CODE,
+
+  windowStart(now: Date): Date {
+    return new Date(now.getTime() - FOLLOW_UP_WINDOW_DAYS * DAY_MS);
+  },
+} as const;
