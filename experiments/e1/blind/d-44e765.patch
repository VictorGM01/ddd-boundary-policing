@@ -0,0 +1,69 @@
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+import { ReportPeriod } from '../domain/report-period';
+import { InvalidReportPeriodError } from '../domain/report.errors';
+import { NoShowReportService } from './no-show-report.service';
+
+class InMemoryNoShowReportRepository extends NoShowReportRepository {
+  readonly rows = new Map<string, { practitionerId?: string; startsAt?: Date; feeCents: number }>();
+
+  async recordNoShow(entry: { appointmentId: string; practitionerId: string; startsAt: Date }) {
+    const row = this.rows.get(entry.appointmentId) ?? { feeCents: 0 };
+    this.rows.set(entry.appointmentId, { ...row, practitionerId: entry.practitionerId, startsAt: entry.startsAt });
+  }
+
+  async recordFee(entry: { appointmentId: string; amountCents: number }) {
+    const row = this.rows.get(entry.appointmentId) ?? { feeCents: 0 };
+    this.rows.set(entry.appointmentId, { ...row, feeCents: entry.amountCents });
+  }
+
+  async summarize(period: ReportPeriod): Promise<PractitionerNoShowSummary[]> {
+    const byPractitioner = new Map<string, PractitionerNoShowSummary>();
+    for (const row of this.rows.values()) {
+      if (!row.practitionerId || !row.startsAt || row.startsAt < period.from || row.startsAt >= period.to) continue;
+      const entry = byPractitioner.get(row.practitionerId) ?? {
+        practitionerId: row.practitionerId,
+        noShows: 0,
+        feesChargedCents: 0,
+      };
+      entry.noShows += 1;
+      entry.feesChargedCents += row.feeCents;
+      byPractitioner.set(row.practitionerId, entry);
+    }
+    return [...byPractitioner.values()];
+  }
+}
+
+describe('NoShowReportService', () => {
+  let service: NoShowReportService;
+
+  beforeEach(() => {
+    service = new NoShowReportService(new InMemoryNoShowReportRepository());
+  });
+
+  it('summarizes no-shows and fees per practitioner within the period', async () => {
+    await service.trackNoShow({ appointmentId: 'a1', practitionerId: 'dr-house', startsAt: new Date('2026-03-02T10:00:00Z') });
+    await service.trackFee({ appointmentId: 'a1', amountCents: 10_000 });
+    await service.trackNoShow({ appointmentId: 'a2', practitionerId: 'dr-house', startsAt: new Date('2026-03-31T10:00:00Z') });
+    await service.trackFee({ appointmentId: 'a2', amountCents: 10_000 });
+    await service.trackNoShow({ appointmentId: 'a3', practitionerId: 'dr-wilson', startsAt: new Date('2026-03-05T10:00:00Z') });
+    await service.trackNoShow({ appointmentId: 'a4', practitionerId: 'dr-house', startsAt: new Date('2026-04-01T10:00:00Z') });
+
+    await expect(service.noShowsBetween('2026-03-01', '2026-03-31')).resolves.toEqual([
+      { practitionerId: 'dr-house', noShows: 2, feesChargedCents: 20_000 },
+      { practitionerId: 'dr-wilson', noShows: 1, feesChargedCents: 0 },
+    ]);
+  });
+
+  it('counts a fee that arrives before its no-show event', async () => {
+    await service.trackFee({ appointmentId: 'a1', amountCents: 10_000 });
+    await service.trackNoShow({ appointmentId: 'a1', practitionerId: 'dr-house', startsAt: new Date('2026-03-02T10:00:00Z') });
+
+    await expect(service.noShowsBetween('2026-03-01', '2026-03-31')).resolves.toEqual([
+      { practitionerId: 'dr-house', noShows: 1, feesChargedCents: 10_000 },
+    ]);
+  });
+
+  it('rejects an invalid period', async () => {
+    await expect(service.noShowsBetween('2026-03-01', undefined)).rejects.toThrow(InvalidReportPeriodError);
+  });
+});
