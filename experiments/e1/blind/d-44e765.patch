+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+import type { ReportPeriod } from '../domain/report-period';
+
+@Injectable()
+export class PrismaNoShowReportRepository extends NoShowReportRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async recordNoShow(entry: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void> {
+    const { appointmentId, ...data } = entry;
+    await this.prisma.reportingNoShow.upsert({
+      where: { appointmentId },
+      create: { appointmentId, ...data },
+      update: data,
+    });
+  }
+
+  async recordFee(entry: { appointmentId: string; amountCents: number }): Promise<void> {
+    await this.prisma.reportingNoShow.upsert({
+      where: { appointmentId: entry.appointmentId },
+      create: { appointmentId: entry.appointmentId, feeCents: entry.amountCents },
+      update: { feeCents: entry.amountCents },
+    });
+  }
+
+  async summarize(period: ReportPeriod): Promise<PractitionerNoShowSummary[]> {
+    const rows = await this.prisma.reportingNoShow.groupBy({
+      by: ['practitionerId'],
+      where: { startsAt: { gte: period.from, lt: period.to } },
+      _count: { _all: true },
+      _sum: { feeCents: true },
+      orderBy: { practitionerId: 'asc' },
+    });
+    return rows.map((row) => ({
+      practitionerId: row.practitionerId as string,
+      noShows: row._count._all,
+      feesChargedCents: row._sum.feeCents ?? 0,
+    }));
+  }
+}
