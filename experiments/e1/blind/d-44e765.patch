+import { Injectable } from '@nestjs/common';
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+import { ReportPeriod } from '../domain/report-period';
+
+@Injectable()
+export class NoShowReportService {
+  constructor(private readonly report: NoShowReportRepository) {}
+
+  async noShowsBetween(from: string | undefined, to: string | undefined): Promise<PractitionerNoShowSummary[]> {
+    return this.report.summarize(ReportPeriod.parse(from, to));
+  }
+
+  async trackNoShow(input: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void> {
+    await this.report.recordNoShow(input);
+  }
+
+  async trackFee(input: { appointmentId: string; amountCents: number }): Promise<void> {
+    await this.report.recordFee(input);
+  }
+}
