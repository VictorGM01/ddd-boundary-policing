+import { ReportPeriod } from './report-period';
+import { InvalidReportPeriodError } from './report.errors';
+
+describe('ReportPeriod', () => {
+  it('treats a date-only `to` as the whole day', () => {
+    const period = ReportPeriod.parse('2026-03-01', '2026-03-31');
+
+    expect(period.from).toEqual(new Date('2026-03-01T00:00:00Z'));
+    expect(period.to).toEqual(new Date('2026-04-01T00:00:00Z'));
+  });
+
+  it('keeps an exact timestamp `to` as the exclusive end', () => {
+    const period = ReportPeriod.parse('2026-03-01T08:00:00Z', '2026-03-01T12:00:00Z');
+
+    expect(period.to).toEqual(new Date('2026-03-01T12:00:00Z'));
+  });
+
+  it.each([
+    [undefined, '2026-03-31'],
+    ['2026-03-01', undefined],
+    ['yesterday', '2026-03-31'],
+    ['2026-03-01', 'soon'],
+    ['2026-03-31', '2026-03-01'],
+    ['2026-03-01T10:00:00Z', '2026-03-01T10:00:00Z'],
+  ])('rejects from=%s to=%s', (from, to) => {
+    expect(() => ReportPeriod.parse(from, to)).toThrow(InvalidReportPeriodError);
+  });
+});
diff --git a/src/modules/reporting/domain/report-period.ts b/src/modules/reporting/domain/report-period.ts
new file mode 100644
index 0000000..3e3ab0d
--- /dev/null
+++ b/src/modules/reporting/domain/report-period.ts
@@ -0,0 +1,31 @@
+import { InvalidReportPeriodError } from './report.errors';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 86_400_000;
+
+/**
+ * Half-open interval [from, to). A date-only `to` (YYYY-MM-DD) covers that whole UTC day,
+ * so `from=2026-03-01&to=2026-03-31` includes every no-show on March 31st.
+ */
+export class ReportPeriod {
+  private constructor(
+    readonly from: Date,
+    readonly to: Date,
+  ) {}
+
+  static parse(from: string | undefined, to: string | undefined): ReportPeriod {
+    if (!from || !to) {
+      throw new InvalidReportPeriodError('from and to are required');
+    }
+    const start = new Date(from);
+    const end = new Date(to);
+    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) {
+      throw new InvalidReportPeriodError('from and to must be ISO-8601 dates');
+    }
+    const exclusiveEnd = DATE_ONLY.test(to) ? new Date(end.getTime() + DAY_MS) : end;
+    if (exclusiveEnd.getTime() <= start.getTime()) {
+      throw new InvalidReportPeriodError('to must be after from');
+    }
+    return new ReportPeriod(start, exclusiveEnd);
+  }
+}
