+import type { ReportPeriod } from './report-period';
+
+export interface PractitionerNoShowSummary {
+  practitionerId: string;
+  noShows: number;
+  feesChargedCents: number;
+}
+
+export abstract class NoShowReportRepository {
+  /** Idempotent; may arrive before or after `recordFee` for the same appointment. */
+  abstract recordNoShow(entry: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void>;
+  abstract recordFee(entry: { appointmentId: string; amountCents: number }): Promise<void>;
+  abstract summarize(period: ReportPeriod): Promise<PractitionerNoShowSummary[]>;
+}
