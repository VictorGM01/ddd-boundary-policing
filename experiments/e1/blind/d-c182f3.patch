diff --git a/src/modules/front-desk/domain/waiting-time-metrics.ts b/src/modules/front-desk/domain/waiting-time-metrics.ts
new file mode 100644
index 0000000..b4e300e
--- /dev/null
+++ b/src/modules/front-desk/domain/waiting-time-metrics.ts
@@ -0,0 +1,22 @@
+import type { Visit } from './visit';
+
+export class WaitingTimeMetrics {
+  private constructor(
+    readonly visitCount: number,
+    readonly averageSeconds: number | null,
+    readonly maxSeconds: number | null,
+  ) {}
+
+  /** Waiting time is the interval from check-in to the start of the encounter; visits not yet served are ignored. */
+  static of(visits: readonly Visit[]): WaitingTimeMetrics {
+    const waits = visits.flatMap((visit) => {
+      const { checkedInAt, servedAt } = visit.toSnapshot();
+      return checkedInAt && servedAt ? [Math.max(0, (servedAt.getTime() - checkedInAt.getTime()) / 1000)] : [];
+    });
+    if (waits.length === 0) {
+      return new WaitingTimeMetrics(0, null, null);
+    }
+    const total = waits.reduce((sum, wait) => sum + wait, 0);
+    return new WaitingTimeMetrics(waits.length, total / waits.length, Math.max(...waits));
+  }
+}
