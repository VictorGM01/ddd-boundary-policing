+import { Injectable } from '@nestjs/common';
+import { InvalidReportPeriodError } from '../domain/no-show-report.errors';
+import { NoShowReportRepository, NoShowReportRow } from '../domain/no-show-report.repository';
+
+@Injectable()
+export class NoShowReportService {
+  constructor(private readonly report: NoShowReportRepository) {}
+
+  async byPractitioner(from: Date, to: Date): Promise<NoShowReportRow[]> {
+    if (from.getTime() >= to.getTime()) {
+      throw new InvalidReportPeriodError();
+    }
+    const rows = await this.report.summarizeByPractitioner(from, to);
+    return [...rows].sort((a, b) => a.practitionerId.localeCompare(b.practitionerId));
+  }
+}
