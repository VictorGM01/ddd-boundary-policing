@@ -0,0 +1,24 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { NoShowReportRepository, NoShowReportRow } from '../domain/no-show-report.repository';
+
+@Injectable()
+export class PrismaNoShowReportRepository extends NoShowReportRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async summarizeByPractitioner(from: Date, to: Date): Promise<NoShowReportRow[]> {
+    const groups = await this.prisma.billingNoShowCharge.groupBy({
+      by: ['practitionerId'],
+      where: { startsAt: { gte: from, lt: to } },
+      _count: { _all: true },
+      _sum: { amountCents: true },
+    });
+    return groups.map((g) => ({
+      practitionerId: g.practitionerId,
+      noShows: g._count._all,
+      feesCents: g._sum.amountCents ?? 0,
+    }));
+  }
+}
