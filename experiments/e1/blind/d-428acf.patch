+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { NoShowReportService } from '../application/no-show-report.service';
+
+@Controller('reports')
+export class ReportsController {
+  constructor(private readonly noShowReport: NoShowReportService) {}
+
+  /** `from` is inclusive and `to` exclusive, both matched against the appointment start time. */
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const start = parseDate('from', from);
+    const end = parseDate('to', to);
+    const rows = await this.noShowReport.byPractitioner(start, end);
+    return {
+      from: start.toISOString(),
+      to: end.toISOString(),
+      practitioners: rows.map((r) => ({
+        practitionerId: r.practitionerId,
+        noShows: r.noShows,
+        feesCents: r.feesCents,
+      })),
+    };
+  }
+}
+
+function parseDate(name: string, value?: string): Date {
+  const date = new Date(value ?? '');
+  if (!value || Number.isNaN(date.getTime())) {
+    throw new BadRequestException(`${name} is required and must be a valid ISO date`);
+  }
+  return date;
+}
