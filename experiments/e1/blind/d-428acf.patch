+import { InvalidReportPeriodError } from '../domain/no-show-report.errors';
+import { NoShowReportRepository, NoShowReportRow } from '../domain/no-show-report.repository';
+import { NoShowReportService } from './no-show-report.service';
+
+class StubReportRepository extends NoShowReportRepository {
+  calls: Array<[Date, Date]> = [];
+
+  constructor(private readonly rows: NoShowReportRow[]) {
+    super();
+  }
+
+  async summarizeByPractitioner(from: Date, to: Date) {
+    this.calls.push([from, to]);
+    return this.rows;
+  }
+}
+
+describe('NoShowReportService', () => {
+  const from = new Date('2026-03-01T00:00:00Z');
+  const to = new Date('2026-04-01T00:00:00Z');
+
+  it('returns the rows ordered by practitioner', async () => {
+    const repository = new StubReportRepository([
+      { practitionerId: 'dr-wilson', noShows: 1, feesCents: 10_000 },
+      { practitionerId: 'dr-house', noShows: 2, feesCents: 20_000 },
+    ]);
+
+    const rows = await new NoShowReportService(repository).byPractitioner(from, to);
+
+    expect(rows.map((r) => r.practitionerId)).toEqual(['dr-house', 'dr-wilson']);
+    expect(repository.calls).toEqual([[from, to]]);
+  });
+
+  it('rejects an empty or inverted period without querying', async () => {
+    const repository = new StubReportRepository([]);
+    const service = new NoShowReportService(repository);
+
+    await expect(service.byPractitioner(to, from)).rejects.toThrow(InvalidReportPeriodError);
+    await expect(service.byPractitioner(from, from)).rejects.toThrow(InvalidReportPeriodError);
+    expect(repository.calls).toEqual([]);
+  });
+});
