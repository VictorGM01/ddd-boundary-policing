diff --git a/src/modules/front-desk/domain/waiting-time-metrics.ts b/src/modules/front-desk/domain/waiting-time-metrics.ts
new file mode 100644
index 0000000..bed0f9c
--- /dev/null
+++ b/src/modules/front-desk/domain/waiting-time-metrics.ts
@@ -0,0 +1,33 @@
+import type { Visit } from './visit';
+
+export class WaitingTimeMetrics {
+  private constructor(private readonly waitsInSeconds: readonly number[]) {}
+
+  /** Only visits whose encounter has started have a finished wait. */
+  static of(visits: readonly Visit[]): WaitingTimeMetrics {
+    const waits: number[] = [];
+    for (const visit of visits) {
+      const { checkedInAt, encounterStartedAt } = visit;
+      if (checkedInAt && encounterStartedAt) {
+        waits.push(Math.max(0, Math.round((encounterStartedAt.getTime() - checkedInAt.getTime()) / 1000)));
+      }
+    }
+    return new WaitingTimeMetrics(waits);
+  }
+
+  get sampleSize(): number {
+    return this.waitsInSeconds.length;
+  }
+
+  get averageSeconds(): number | null {
+    if (this.waitsInSeconds.length === 0) {
+      return null;
+    }
+    const total = this.waitsInSeconds.reduce((sum, wait) => sum + wait, 0);
+    return Math.round(total / this.waitsInSeconds.length);
+  }
+
+  get maximumSeconds(): number | null {
+    return this.waitsInSeconds.length === 0 ? null : Math.max(...this.waitsInSeconds);
+  }
+}
