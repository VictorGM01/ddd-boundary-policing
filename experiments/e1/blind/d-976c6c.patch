@@ -0,0 +1,36 @@
+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { InvoicingService } from '../application/invoicing.service';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+@Controller('reports')
+export class NoShowReportController {
+  constructor(private readonly invoicing: InvoicingService) {}
+
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const period = {
+      from: parseInstant('from', from, false),
+      to: parseInstant('to', to, true),
+    };
+    const rows = await this.invoicing.noShowReport(period);
+    return {
+      from: period.from.toISOString(),
+      to: period.to.toISOString(),
+      practitioners: rows,
+    };
+  }
+}
+
+/** Accepts an ISO timestamp or a bare date; a bare `to` date covers that whole day. */
+function parseInstant(name: string, value: string | undefined, endOfDay: boolean): Date {
+  if (!value) {
+    throw new BadRequestException(`${name} is required`);
+  }
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    throw new BadRequestException(`${name} must be an ISO 8601 date or timestamp`);
+  }
+  return endOfDay && DATE_ONLY.test(value) ? new Date(date.getTime() + DAY_MS - 1) : date;
+}
