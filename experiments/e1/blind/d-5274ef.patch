+import { OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  private readonly rows = new Map<string, VisitSnapshot>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const row = [...this.rows.values()].find((r) => r.appointmentId === appointmentId);
+    return row ? Visit.restore(row) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.rows.values()].filter((r) => r.status === 'CHECKED_IN').map((r) => Visit.restore(r));
+  }
+
+  async save(visit: Visit) {
+    this.rows.set(visit.id, visit.toSnapshot());
+  }
+}
+
+class InMemoryOutstandingBalanceRepository extends OutstandingBalanceRepository {
+  readonly items: OutstandingBalance[] = [];
+
+  async findByPersonId(personId: string) {
+    return this.items.filter((b) => b.toSnapshot().personId === personId);
+  }
+
+  async existsForBillingRef(billingRef: string) {
+    return this.items.some((b) => b.toSnapshot().billingRef === billingRef);
+  }
+
+  async save(balance: OutstandingBalance) {
+    this.items.push(balance);
+  }
+}
+
+describe('VisitsService check-in', () => {
+  const now = new Date('2026-03-02T09:50:00Z');
+  const daysAgo = (days: number, extraMs = 0) => new Date(now.getTime() - days * 86_400_000 - extraMs);
+  let visits: InMemoryVisitRepository;
+  let balances: InMemoryOutstandingBalanceRepository;
+  let events: { emitAsync: jest.Mock };
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    visits = new InMemoryVisitRepository();
+    balances = new InMemoryOutstandingBalanceRepository();
+    events = { emitAsync: jest.fn().mockResolvedValue([]) };
+    service = new VisitsService(visits, balances, new FixedClock(now), events as unknown as EventEmitter2);
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-03-02T10:00:00Z'),
+    });
+  });
+
+  it('checks in a visitor without outstanding balance', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+    expect(events.emitAsync).toHaveBeenCalledWith(FrontDeskEvents.VisitorCheckedIn, expect.any(Object));
+  });
+
+  it('checks in a visitor whose balance is not older than 30 days', async () => {
+    await service.recordOutstandingBalance({ billingRef: 'inv-1', personId: 'person-1', since: daysAgo(30) });
+
+    await expect(service.checkIn('appt-1')).resolves.toMatchObject({ status: 'CHECKED_IN' });
+  });
+
+  it('refuses the check-in when a balance is older than 30 days', async () => {
+    await service.recordOutstandingBalance({ billingRef: 'inv-1', personId: 'person-1', since: daysAgo(30, 1) });
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+    expect(events.emitAsync).not.toHaveBeenCalled();
+    expect((await visits.findByAppointmentId('appt-1'))?.status).toBe('EXPECTED');
+  });
+
+  it('refuses when only one of several balances is overdue', async () => {
+    await service.recordOutstandingBalance({ billingRef: 'inv-1', personId: 'person-1', since: daysAgo(2) });
+    await service.recordOutstandingBalance({ billingRef: 'inv-2', personId: 'person-1', since: daysAgo(45) });
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+  });
+
+  it('ignores overdue balances of other people', async () => {
+    await service.recordOutstandingBalance({ billingRef: 'inv-1', personId: 'person-2', since: daysAgo(90) });
+
+    await expect(service.checkIn('appt-1')).resolves.toMatchObject({ status: 'CHECKED_IN' });
+  });
+
+  it('records the same invoice only once', async () => {
+    const command = { billingRef: 'inv-1', personId: 'person-1', since: daysAgo(1) };
+    await service.recordOutstandingBalance(command);
+    await service.recordOutstandingBalance(command);
+
+    expect(balances.items).toHaveLength(1);
+  });
+});
