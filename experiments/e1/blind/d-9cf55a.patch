@@ -0,0 +1,21 @@
+import type { PractitionerId } from '@/shared-kernel';
+
+export interface NoShowCharge {
+  id: string;
+  appointmentId: string;
+  practitionerId: PractitionerId;
+  startsAt: Date;
+  amountCents: number;
+}
+
+export interface PractitionerNoShowSummary {
+  practitionerId: PractitionerId;
+  noShows: number;
+  totalFeesCents: number;
+}
+
+export abstract class NoShowChargeRepository {
+  abstract save(charge: NoShowCharge): Promise<void>;
+  /** Summarises charges whose appointment started in `[from, to)`, ordered by practitionerId. */
+  abstract summarizeByPractitioner(from: Date, to: Date): Promise<PractitionerNoShowSummary[]>;
+}
diff --git a/src/modules/billing/infrastructure/prisma-no-show-charge.repository.ts b/src/modules/billing/infrastructure/prisma-no-show-charge.repository.ts
new file mode 100644
index 0000000..56acc77
--- /dev/null
+++ b/src/modules/billing/infrastructure/prisma-no-show-charge.repository.ts
@@ -0,0 +1,33 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import {
+  NoShowCharge,
+  NoShowChargeRepository,
+  PractitionerNoShowSummary,
+} from '../domain/no-show-charge.repository';
+
+@Injectable()
+export class PrismaNoShowChargeRepository extends NoShowChargeRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async save(charge: NoShowCharge): Promise<void> {
+    await this.prisma.billingNoShowCharge.create({ data: charge });
+  }
+
+  async summarizeByPractitioner(from: Date, to: Date): Promise<PractitionerNoShowSummary[]> {
+    const groups = await this.prisma.billingNoShowCharge.groupBy({
+      by: ['practitionerId'],
+      where: { startsAt: { gte: from, lt: to } },
+      _count: { _all: true },
+      _sum: { amountCents: true },
+      orderBy: { practitionerId: 'asc' },
+    });
+    return groups.map((g) => ({
+      practitionerId: g.practitionerId,
+      noShows: g._count._all,
+      totalFeesCents: g._sum.amountCents ?? 0,
+    }));
+  }
+}
