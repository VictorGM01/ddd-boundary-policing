index 0000000..bc441b0
--- /dev/null
+++ b/src/modules/billing/application/no-show-report.service.spec.ts
@@ -0,0 +1,75 @@
+import { InvalidReportPeriodError } from '../domain/invoice.errors';
+import {
+  NoShowCharge,
+  NoShowChargeRepository,
+  PractitionerNoShowSummary,
+} from '../domain/no-show-charge.repository';
+import { NoShowReportService } from './no-show-report.service';
+
+class InMemoryNoShowChargeRepository extends NoShowChargeRepository {
+  readonly items: NoShowCharge[] = [];
+
+  async save(charge: NoShowCharge) {
+    this.items.push(charge);
+  }
+
+  async summarizeByPractitioner(from: Date, to: Date) {
+    const byPractitioner = new Map<string, PractitionerNoShowSummary>();
+    for (const c of this.items) {
+      if (c.startsAt < from || c.startsAt >= to) continue;
+      const entry = byPractitioner.get(c.practitionerId) ?? {
+        practitionerId: c.practitionerId,
+        noShows: 0,
+        totalFeesCents: 0,
+      };
+      entry.noShows += 1;
+      entry.totalFeesCents += c.amountCents;
+      byPractitioner.set(c.practitionerId, entry);
+    }
+    return [...byPractitioner.values()];
+  }
+}
+
+describe('NoShowReportService', () => {
+  let repository: InMemoryNoShowChargeRepository;
+  let service: NoShowReportService;
+
+  const charge = (id: string, practitionerId: string, startsAt: string, amountCents = 10_000): NoShowCharge => ({
+    id,
+    appointmentId: id,
+    practitionerId,
+    startsAt: new Date(startsAt),
+    amountCents,
+  });
+
+  beforeEach(() => {
+    repository = new InMemoryNoShowChargeRepository();
+    service = new NoShowReportService(repository);
+  });
+
+  it('totals no-shows and fees per practitioner inside the period', async () => {
+    repository.items.push(
+      charge('1', 'dr-house', '2026-03-02T10:00:00Z'),
+      charge('2', 'dr-house', '2026-03-10T10:00:00Z'),
+      charge('3', 'dr-wilson', '2026-03-11T10:00:00Z'),
+      charge('4', 'dr-wilson', '2026-05-01T10:00:00Z'),
+    );
+
+    await expect(service.report('2026-03-01', '2026-03-31')).resolves.toEqual([
+      { practitionerId: 'dr-house', noShows: 2, totalFeesCents: 20_000 },
+      { practitionerId: 'dr-wilson', noShows: 1, totalFeesCents: 10_000 },
+    ]);
+  });
+
+  it('treats a date-only "to" as the whole day, and a date-time "to" as inclusive', async () => {
+    repository.items.push(charge('1', 'dr-house', '2026-03-31T23:30:00Z'), charge('2', 'dr-wilson', '2026-04-01T00:00:00Z'));
+
+    expect(await service.report('2026-03-31', '2026-03-31')).toHaveLength(1);
+    expect(await service.report('2026-03-31T00:00:00Z', '2026-04-01T00:00:00Z')).toHaveLength(2);
+  });
+
+  it('rejects unparsable or inverted periods', async () => {
+    await expect(service.report('nope', '2026-03-31')).rejects.toThrow(InvalidReportPeriodError);
+    await expect(service.report('2026-03-31', '2026-03-01')).rejects.toThrow(InvalidReportPeriodError);
+  });
+});
diff --git a/src/modules/billing/application/no-show-report.service.ts b/src/modules/billing/application/no-show-report.service.ts
new file mode 100644
index 0000000..84d68bf
--- /dev/null
+++ b/src/modules/billing/application/no-show-report.service.ts
@@ -0,0 +1,33 @@
+import { Injectable } from '@nestjs/common';
+import { InvalidReportPeriodError } from '../domain/invoice.errors';
+import { NoShowChargeRepository, PractitionerNoShowSummary } from '../domain/no-show-charge.repository';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+@Injectable()
+export class NoShowReportService {
+  constructor(private readonly charges: NoShowChargeRepository) {}
+
+  /**
+   * Both bounds are inclusive. A date-only `to` (YYYY-MM-DD) covers that whole day in UTC.
+   * The period is matched against the start time of the missed appointment.
+   */
+  async report(from: string, to: string): Promise<PractitionerNoShowSummary[]> {
+    const start = parseInstant('from', from);
+    const end = parseInstant('to', to);
+    if (end.getTime() < start.getTime()) {
+      throw new InvalidReportPeriodError('"from" must not be after "to"');
+    }
+    const endExclusive = new Date(DATE_ONLY.test(to) ? end.getTime() + DAY_MS : end.getTime() + 1);
+    return this.charges.summarizeByPractitioner(start, endExclusive);
+  }
+}
+
+function parseInstant(name: string, value: string): Date {
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    throw new InvalidReportPeriodError(`"${name}" must be an ISO 8601 date or date-time`);
+  }
+  return date;
+}
