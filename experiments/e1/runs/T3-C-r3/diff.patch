@@ -0,0 +1,32 @@
+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { InvoicingService } from '../application/invoicing.service';
+
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
+
+@Controller('reports')
+export class ReportsController {
+  constructor(private readonly invoicing: InvoicingService) {}
+
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const start = parseBound('from', from, false);
+    const end = parseBound('to', to, true);
+    if (start > end) {
+      throw new BadRequestException('"from" must not be after "to"');
+    }
+    const practitioners = await this.invoicing.noShowReport(start, end);
+    return { from: start.toISOString(), to: end.toISOString(), practitioners };
+  }
+}
+
+/** A date-only `to` covers that whole day (UTC); full timestamps are taken as given. */
+function parseBound(name: string, value: string | undefined, endOfDay: boolean): Date {
+  if (!value) {
+    throw new BadRequestException(`"${name}" is required`);
+  }
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    throw new BadRequestException(`"${name}" must be an ISO date`);
+  }
+  return endOfDay && DATE_ONLY.test(value) ? new Date(date.getTime() + 86_400_000 - 1) : date;
+}
