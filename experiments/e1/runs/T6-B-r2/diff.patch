@@ -0,0 +1,70 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FixedClock } from '@/shared-kernel';
+import { Visit } from '../domain/visit';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    return [...this.items.values()].find((v) => v.toSnapshot().appointmentId === appointmentId) ?? null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async findCheckedInBetween(from: Date, to: Date) {
+    return (await this.findCheckedIn()).filter((v) => {
+      const at = v.checkedInAt as Date;
+      return at >= from && at < to;
+    });
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.id, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+describe('VisitsService queue metrics', () => {
+  const clock = new FixedClock(new Date('2026-03-02T08:00:00Z'));
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    clock.set(new Date('2026-03-02T08:00:00Z'));
+    service = new VisitsService(new InMemoryVisitRepository(), clock, new EventEmitter2());
+    for (const id of ['a', 'b', 'c']) {
+      await service.expectVisitor({
+        appointmentId: id,
+        personId: `person-${id}`,
+        practitionerId: 'dr-1',
+        expectedAt: new Date('2026-03-02T10:00:00Z'),
+      });
+    }
+  });
+
+  it("averages today's waiting times and ignores check-ins from other days", async () => {
+    clock.set(new Date('2026-03-01T23:50:00Z'));
+    await service.checkIn('c');
+    await service.markAttended('c', new Date('2026-03-02T00:30:00Z'));
+
+    clock.set(new Date('2026-03-02T09:00:00Z'));
+    await service.checkIn('a');
+    clock.set(new Date('2026-03-02T09:10:00Z'));
+    await service.checkIn('b');
+    await service.markAttended('a', new Date('2026-03-02T09:10:00Z'));
+    await service.markAttended('b', new Date('2026-03-02T09:40:00Z'));
+
+    expect(await service.queueMetricsToday()).toEqual({
+      date: '2026-03-02',
+      attendedCount: 2,
+      averageWaitingSeconds: 20 * 60,
+      maxWaitingSeconds: 30 * 60,
+    });
+  });
+
+  it('ignores attendance of unknown appointments', async () => {
+    await expect(service.markAttended('unknown', new Date())).resolves.toBeUndefined();
+  });
+});
