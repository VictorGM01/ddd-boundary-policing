@@ -0,0 +1,60 @@
+import { QueueMetrics } from './queue-metrics';
+import { Visit } from './visit';
+
+function visit(id: string, checkedInAt: string | null, attendedAt: string | null): Visit {
+  const v = Visit.expect({
+    id,
+    appointmentId: `appt-${id}`,
+    personId: 'person-1',
+    practitionerId: 'dr-1',
+    expectedAt: new Date('2026-03-02T10:00:00Z'),
+  });
+  if (checkedInAt) v.checkIn(new Date(checkedInAt));
+  if (attendedAt) v.markAttended(new Date(attendedAt));
+  return v;
+}
+
+describe('QueueMetrics', () => {
+  it('computes average and maximum waiting time between check-in and attendance', () => {
+    const metrics = QueueMetrics.of([
+      visit('a', '2026-03-02T09:00:00Z', '2026-03-02T09:10:00Z'),
+      visit('b', '2026-03-02T09:05:00Z', '2026-03-02T09:35:00Z'),
+    ]);
+
+    expect(metrics.toSnapshot()).toEqual({
+      attendedCount: 2,
+      averageWaitingSeconds: 20 * 60,
+      maxWaitingSeconds: 30 * 60,
+    });
+  });
+
+  it('ignores visitors who are still waiting or never checked in', () => {
+    const metrics = QueueMetrics.of([
+      visit('a', '2026-03-02T09:00:00Z', '2026-03-02T09:10:00Z'),
+      visit('waiting', '2026-03-02T09:00:00Z', null),
+      visit('absent', null, null),
+    ]);
+
+    expect(metrics.toSnapshot().attendedCount).toBe(1);
+  });
+
+  it('reports no averages when nobody was attended', () => {
+    expect(QueueMetrics.of([]).toSnapshot()).toEqual({
+      attendedCount: 0,
+      averageWaitingSeconds: null,
+      maxWaitingSeconds: null,
+    });
+  });
+});
+
+describe('Visit.markAttended', () => {
+  it('keeps the first attendance time and ignores visits that are not checked in', () => {
+    const attended = visit('a', '2026-03-02T09:00:00Z', '2026-03-02T09:10:00Z');
+    attended.markAttended(new Date('2026-03-02T09:20:00Z'));
+    expect(attended.attendedAt).toEqual(new Date('2026-03-02T09:10:00Z'));
+
+    const expected = visit('b', null, null);
+    expected.markAttended(new Date('2026-03-02T09:20:00Z'));
+    expect(expected.attendedAt).toBeNull();
+  });
+});
diff --git a/src/modules/front-desk/domain/queue-metrics.ts b/src/modules/front-desk/domain/queue-metrics.ts
new file mode 100644
index 0000000..773b7ac
--- /dev/null
+++ b/src/modules/front-desk/domain/queue-metrics.ts
@@ -0,0 +1,35 @@
+import type { Visit } from './visit';
+
+export interface QueueMetricsSnapshot {
+  attendedCount: number;
+  averageWaitingSeconds: number | null;
+  maxWaitingSeconds: number | null;
+}
+
+export class QueueMetrics {
+  private constructor(private readonly waitingMs: readonly number[]) {}
+
+  /** Considers only visitors who checked in and were already attended; those still waiting have no waiting time yet. */
+  static of(visits: readonly Visit[]): QueueMetrics {
+    const waitingMs = visits.flatMap((visit) => {
+      const { checkedInAt, attendedAt } = visit;
+      if (visit.status !== 'CHECKED_IN' || checkedInAt === null || attendedAt === null) {
+        return [];
+      }
+      return [Math.max(0, attendedAt.getTime() - checkedInAt.getTime())];
+    });
+    return new QueueMetrics(waitingMs);
+  }
+
+  toSnapshot(): QueueMetricsSnapshot {
+    if (this.waitingMs.length === 0) {
+      return { attendedCount: 0, averageWaitingSeconds: null, maxWaitingSeconds: null };
+    }
+    const total = this.waitingMs.reduce((sum, ms) => sum + ms, 0);
+    return {
+      attendedCount: this.waitingMs.length,
+      averageWaitingSeconds: Math.round(total / this.waitingMs.length / 1000),
+      maxWaitingSeconds: Math.round(Math.max(...this.waitingMs) / 1000),
+    };
+  }
+}
