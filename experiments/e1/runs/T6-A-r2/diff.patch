diff --git a/src/modules/front-desk/domain/waiting-time-metrics.ts b/src/modules/front-desk/domain/waiting-time-metrics.ts
new file mode 100644
index 0000000..42ce419
--- /dev/null
+++ b/src/modules/front-desk/domain/waiting-time-metrics.ts
@@ -0,0 +1,21 @@
+import type { Visit } from './visit';
+
+export interface WaitingTimeMetrics {
+  /** Number of visits that already left the queue and entered an encounter. */
+  attended: number;
+  averageWaitingMs: number | null;
+  maximumWaitingMs: number | null;
+}
+
+export function waitingTimeMetrics(visits: readonly Visit[]): WaitingTimeMetrics {
+  const waits = visits.map((visit) => visit.waitingTimeMs).filter((ms): ms is number => ms !== null);
+  if (waits.length === 0) {
+    return { attended: 0, averageWaitingMs: null, maximumWaitingMs: null };
+  }
+  const total = waits.reduce((sum, ms) => sum + ms, 0);
+  return {
+    attended: waits.length,
+    averageWaitingMs: Math.round(total / waits.length),
+    maximumWaitingMs: Math.max(...waits),
+  };
+}
