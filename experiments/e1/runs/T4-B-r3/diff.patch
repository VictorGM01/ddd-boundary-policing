@@ -0,0 +1,31 @@
+import type { PersonId } from '@/shared-kernel';
+
+export const OVERDUE_AFTER_DAYS = 30;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export interface OutstandingBalanceSnapshot {
+  id: string;
+  personId: PersonId;
+  since: Date;
+}
+
+export class OutstandingBalance {
+  private constructor(private readonly props: OutstandingBalanceSnapshot) {}
+
+  static record(input: OutstandingBalanceSnapshot): OutstandingBalance {
+    return new OutstandingBalance({ ...input });
+  }
+
+  static restore(snapshot: OutstandingBalanceSnapshot): OutstandingBalance {
+    return new OutstandingBalance({ ...snapshot });
+  }
+
+  isOverdue(now: Date): boolean {
+    return now.getTime() - this.props.since.getTime() > OVERDUE_AFTER_DAYS * DAY_MS;
+  }
+
+  toSnapshot(): OutstandingBalanceSnapshot {
+    return { ...this.props };
+  }
+}
