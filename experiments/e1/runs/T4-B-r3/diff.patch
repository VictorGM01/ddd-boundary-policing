@@ -0,0 +1,27 @@
+import { Injectable } from '@nestjs/common';
+import type { FrontDeskOutstandingBalance } from '@prisma/client';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import type { PersonId } from '@/shared-kernel';
+import { OutstandingBalance } from '../domain/outstanding-balance';
+import { OutstandingBalanceRepository } from '../domain/outstanding-balance.repository';
+
+@Injectable()
+export class PrismaOutstandingBalanceRepository extends OutstandingBalanceRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async findByPersonId(personId: PersonId): Promise<OutstandingBalance[]> {
+    const rows = await this.prisma.frontDeskOutstandingBalance.findMany({ where: { personId } });
+    return rows.map(toDomain);
+  }
+
+  async save(balance: OutstandingBalance): Promise<void> {
+    const { id, ...data } = balance.toSnapshot();
+    await this.prisma.frontDeskOutstandingBalance.upsert({ where: { id }, create: { id, ...data }, update: data });
+  }
+}
+
+function toDomain(row: FrontDeskOutstandingBalance): OutstandingBalance {
+  return OutstandingBalance.restore(row);
+}
