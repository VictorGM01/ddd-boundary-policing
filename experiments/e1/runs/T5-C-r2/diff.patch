+  /**
+   * A consultation repeated for the same payer and practitioner within 30 days of a previously charged one is a
+   * follow-up and is not charged again. Returns null when nothing is left to charge.
+   */
+  async invoiceEncounter(input: {
+    encounterId: string;
+    payerId: PersonId;
+    practitionerId: PractitionerId;
+    procedureCodes: string[];
+  }): Promise<Invoice | null> {
+    const source: InvoiceSource = { type: 'ENCOUNTER', id: input.encounterId };
+    if (await this.invoices.existsForSource(source)) {
+      throw new SourceAlreadyInvoicedError(source.type, source.id);
+    }
+    const now = this.clock.now();
+    const isFollowUp =
+      input.procedureCodes.includes(CONSULTATION_CODE) &&
+      (await this.invoices.existsChargedLine({
+        payerId: input.payerId,
+        practitionerId: input.practitionerId,
+        code: CONSULTATION_CODE,
+        since: new Date(now.getTime() - FOLLOW_UP_WINDOW_DAYS * DAY_MS),
+      }));
+    const chargeable = isFollowUp ? input.procedureCodes.filter((c) => c !== CONSULTATION_CODE) : input.procedureCodes;
+    if (chargeable.length === 0) {
+      return null;
+    }
+    return this.issue(input.payerId, source, this.priceList.linesFor(chargeable), input.practitionerId);
   }
 
