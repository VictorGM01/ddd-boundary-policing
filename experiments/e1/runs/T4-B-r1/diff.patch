@@ -0,0 +1,101 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FrontDeskEvents } from '@/contracts/front-desk.events';
+import { FixedClock } from '@/shared-kernel';
+import { Visit } from '../domain/visit';
+import { OverdueBalanceError, VisitAlreadyCheckedInError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitorBalanceRepository, VisitorInvoiceRecord } from '../domain/visitor-balance.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const found = [...this.items.values()].find((v) => v.toSnapshot().appointmentId === appointmentId);
+    return found ? Visit.restore(found.toSnapshot()) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.id, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+class InMemoryVisitorBalanceRepository extends VisitorBalanceRepository {
+  readonly items = new Map<string, VisitorInvoiceRecord>();
+
+  async record(invoice: VisitorInvoiceRecord) {
+    this.items.set(invoice.invoiceId, invoice);
+  }
+
+  async hasInvoiceIssuedBefore(personId: string, cutoff: Date) {
+    return [...this.items.values()].some((i) => i.personId === personId && i.issuedAt < cutoff);
+  }
+}
+
+describe('VisitsService check-in', () => {
+  const now = new Date('2026-03-31T09:00:00Z');
+  const daysAgo = (days: number, extraMs = 0) => new Date(now.getTime() - days * 24 * 60 * 60 * 1000 - extraMs);
+
+  let visits: InMemoryVisitRepository;
+  let balances: InMemoryVisitorBalanceRepository;
+  let events: EventEmitter2;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    visits = new InMemoryVisitRepository();
+    balances = new InMemoryVisitorBalanceRepository();
+    events = new EventEmitter2();
+    service = new VisitsService(visits, balances, new FixedClock(now), events);
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-03-31T10:00:00Z'),
+    });
+  });
+
+  it('checks in a visitor without any invoice', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('refuses the check-in when an invoice is older than 30 days, without persisting or publishing', async () => {
+    await service.trackVisitorInvoice({ invoiceId: 'inv-1', personId: 'person-1', issuedAt: daysAgo(30, 1) });
+    const published: unknown[] = [];
+    events.on(FrontDeskEvents.VisitorCheckedIn, (event) => published.push(event));
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+
+    expect((await visits.findByAppointmentId('appt-1'))?.status).toBe('EXPECTED');
+    expect(published).toHaveLength(0);
+  });
+
+  it('accepts an invoice issued exactly 30 days ago or less', async () => {
+    await service.trackVisitorInvoice({ invoiceId: 'inv-1', personId: 'person-1', issuedAt: daysAgo(30) });
+    await service.trackVisitorInvoice({ invoiceId: 'inv-2', personId: 'person-1', issuedAt: daysAgo(5) });
+
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('ignores overdue invoices of other visitors', async () => {
+    await service.trackVisitorInvoice({ invoiceId: 'inv-1', personId: 'person-2', issuedAt: daysAgo(90) });
+
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('keeps reporting the visit state error first for an already checked-in visitor', async () => {
+    await service.checkIn('appt-1');
+    await service.trackVisitorInvoice({ invoiceId: 'inv-1', personId: 'person-1', issuedAt: daysAgo(90) });
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(VisitAlreadyCheckedInError);
+  });
+});
