@@ -0,0 +1,26 @@
+import { Injectable } from '@nestjs/common';
+import { PersonId } from '@/shared-kernel';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { VisitorBalanceRepository, VisitorInvoiceRecord } from '../domain/visitor-balance.repository';
+
+@Injectable()
+export class PrismaVisitorBalanceRepository extends VisitorBalanceRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async record({ invoiceId, personId, issuedAt }: VisitorInvoiceRecord): Promise<void> {
+    await this.prisma.frontDeskVisitorInvoice.upsert({
+      where: { invoiceId },
+      create: { invoiceId, personId, issuedAt },
+      update: {},
+    });
+  }
+
+  async hasInvoiceIssuedBefore(personId: PersonId, cutoff: Date): Promise<boolean> {
+    const count = await this.prisma.frontDeskVisitorInvoice.count({
+      where: { personId, issuedAt: { lt: cutoff } },
+    });
+    return count > 0;
+  }
+}
