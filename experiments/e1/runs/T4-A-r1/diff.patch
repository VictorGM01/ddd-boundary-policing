index 0000000..e34e731
--- /dev/null
+++ b/src/modules/front-desk/application/visits.service.spec.ts
@@ -0,0 +1,84 @@
+import { NotFoundException } from '@nestjs/common';
+import type { EventEmitter2 } from '@nestjs/event-emitter';
+import { OverdueBalanceQuery } from '@/contracts/billing.queries';
+import { FrontDeskEvents } from '@/contracts/front-desk.events';
+import { FixedClock } from '@/shared-kernel';
+import { Visit, VisitSnapshot } from '../domain/visit';
+import { OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  private readonly rows = new Map<string, VisitSnapshot>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const row = [...this.rows.values()].find((r) => r.appointmentId === appointmentId);
+    return row ? Visit.restore(row) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.rows.values()].filter((r) => r.status === 'CHECKED_IN').map((r) => Visit.restore(r));
+  }
+
+  async save(visit: Visit) {
+    this.rows.set(visit.id, visit.toSnapshot());
+  }
+}
+
+class StubOverdueBalanceQuery extends OverdueBalanceQuery {
+  readonly overdue = new Set<string>();
+
+  async hasOverdueBalance(personId: string) {
+    return this.overdue.has(personId);
+  }
+}
+
+describe('VisitsService.checkIn', () => {
+  let repository: InMemoryVisitRepository;
+  let overdue: StubOverdueBalanceQuery;
+  let emitAsync: jest.Mock;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    repository = new InMemoryVisitRepository();
+    overdue = new StubOverdueBalanceQuery();
+    emitAsync = jest.fn().mockResolvedValue([]);
+    service = new VisitsService(
+      repository,
+      overdue,
+      new FixedClock(new Date('2026-03-02T09:50:00Z')),
+      { emitAsync } as unknown as EventEmitter2,
+    );
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-03-02T10:00:00Z'),
+    });
+  });
+
+  it('checks the visitor in when there is no overdue balance', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+    expect(emitAsync).toHaveBeenCalledWith(FrontDeskEvents.VisitorCheckedIn, expect.anything());
+  });
+
+  it('refuses the check-in when the visitor has an overdue balance', async () => {
+    overdue.overdue.add('person-1');
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+    expect((await repository.findByAppointmentId('appt-1'))?.status).toBe('EXPECTED');
+    expect(emitAsync).not.toHaveBeenCalled();
+  });
+
+  it('is not affected by the overdue balance of someone else', async () => {
+    overdue.overdue.add('person-2');
+
+    await expect(service.checkIn('appt-1')).resolves.toBeDefined();
+  });
+
+  it('still reports an unknown appointment as not found', async () => {
+    await expect(service.checkIn('missing')).rejects.toThrow(NotFoundException);
+  });
+});
