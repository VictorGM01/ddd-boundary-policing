diff --git a/src/modules/billing/domain/follow-up-policy.ts b/src/modules/billing/domain/follow-up-policy.ts
new file mode 100644
index 0000000..3031a99
--- /dev/null
+++ b/src/modules/billing/domain/follow-up-policy.ts
@@ -0,0 +1,13 @@
+import type { InvoiceLine } from './invoice';
+import { CONSULTATION_CODE, FOLLOW_UP_WINDOW_DAYS } from './price-list';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export function followUpWindowStart(now: Date): Date {
+  return new Date(now.getTime() - FOLLOW_UP_WINDOW_DAYS * DAY_MS);
+}
+
+/** A follow-up does not pay the consultation again; every other procedure is still charged. */
+export function waiveConsultation(lines: InvoiceLine[], isFollowUp: boolean): InvoiceLine[] {
+  return isFollowUp ? lines.filter((line) => line.code !== CONSULTATION_CODE) : lines;
+}
