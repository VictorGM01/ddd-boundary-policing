+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FixedClock } from '@/shared-kernel';
+import { OpenInvoice } from '../domain/open-invoice';
+import { OpenInvoiceRepository } from '../domain/open-invoice.repository';
+import { Visit } from '../domain/visit';
+import { CheckInNotAllowedError, OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const found = [...this.items.values()].find((v) => v.toSnapshot().appointmentId === appointmentId);
+    return found ? Visit.restore(found.toSnapshot()) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async save(visit: Visit) {
+    // Copy on write and on read so unsaved in-memory changes never leak into the "database".
+    this.items.set(visit.id, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+class InMemoryOpenInvoiceRepository extends OpenInvoiceRepository {
+  readonly items = new Map<string, OpenInvoice>();
+
+  async findByPersonId(personId: string) {
+    return [...this.items.values()].filter((i) => i.toSnapshot().personId === personId);
+  }
+
+  async save(invoice: OpenInvoice) {
+    this.items.set(invoice.toSnapshot().invoiceId, invoice);
+  }
+}
+
+describe('VisitsService.checkIn', () => {
+  const now = new Date('2026-04-01T12:00:00Z');
+  let visits: InMemoryVisitRepository;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    visits = new InMemoryVisitRepository();
+    service = new VisitsService(visits, new InMemoryOpenInvoiceRepository(), new FixedClock(now), new EventEmitter2());
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-04-01T13:00:00Z'),
+    });
+  });
+
+  function owe(invoiceId: string, personId: string, issuedAt: string): Promise<void> {
+    return service.recordOpenInvoice({ invoiceId, personId, issuedAt: new Date(issuedAt) });
+  }
+
+  it('checks in a visitor without invoices', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('checks in a visitor whose open invoices are at most 30 days old', async () => {
+    await owe('inv-1', 'person-1', '2026-03-02T12:00:00Z');
+
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('refuses the check-in when an open invoice is older than 30 days, leaving the visit expected', async () => {
+    await owe('inv-1', 'person-1', '2026-03-02T11:59:00Z');
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+    expect((await visits.findByAppointmentId('appt-1'))?.status).toBe('EXPECTED');
+  });
+
+  it('refuses the check-in when only one of several invoices is overdue', async () => {
+    await owe('inv-1', 'person-1', '2026-03-30T12:00:00Z');
+    await owe('inv-2', 'person-1', '2026-01-15T12:00:00Z');
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+  });
+
+  it('ignores overdue invoices of other visitors', async () => {
+    await owe('inv-1', 'person-2', '2026-01-15T12:00:00Z');
+
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('records the same invoice only once', async () => {
+    await owe('inv-1', 'person-1', '2026-03-30T12:00:00Z');
+    await owe('inv-1', 'person-1', '2026-03-30T12:00:00Z');
+
+    expect(await service.checkIn('appt-1')).toBeDefined();
+  });
+
+  it('reports status problems before the balance', async () => {
+    await owe('inv-1', 'person-1', '2026-01-15T12:00:00Z');
+    await service.cancelExpectedVisit('appt-1');
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(CheckInNotAllowedError);
+  });
+});
