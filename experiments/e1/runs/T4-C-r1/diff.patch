@@ -0,0 +1,30 @@
+import { Injectable } from '@nestjs/common';
+import type { FrontDeskOpenInvoice } from '@prisma/client';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { OpenInvoice } from '../domain/open-invoice';
+import { OpenInvoiceRepository } from '../domain/open-invoice.repository';
+
+@Injectable()
+export class PrismaOpenInvoiceRepository extends OpenInvoiceRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async findByPersonId(personId: string): Promise<OpenInvoice[]> {
+    const rows = await this.prisma.frontDeskOpenInvoice.findMany({ where: { personId } });
+    return rows.map(toDomain);
+  }
+
+  async save(invoice: OpenInvoice): Promise<void> {
+    const { invoiceId, ...data } = invoice.toSnapshot();
+    await this.prisma.frontDeskOpenInvoice.upsert({
+      where: { invoiceId },
+      create: { invoiceId, ...data },
+      update: data,
+    });
+  }
+}
+
+function toDomain(row: FrontDeskOpenInvoice): OpenInvoice {
+  return OpenInvoice.record(row);
+}
