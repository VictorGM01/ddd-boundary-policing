@@ -0,0 +1,26 @@
+import type { PersonId } from '@/shared-kernel';
+
+export const OVERDUE_AFTER_DAYS = 30;
+
+export interface OpenInvoiceSnapshot {
+  invoiceId: string;
+  personId: PersonId;
+  issuedAt: Date;
+}
+
+export class OpenInvoice {
+  private constructor(private readonly props: OpenInvoiceSnapshot) {}
+
+  static record(snapshot: OpenInvoiceSnapshot): OpenInvoice {
+    return new OpenInvoice({ ...snapshot });
+  }
+
+  isOverdueAt(now: Date): boolean {
+    const cutoff = now.getTime() - OVERDUE_AFTER_DAYS * 24 * 60 * 60_000;
+    return this.props.issuedAt.getTime() < cutoff;
+  }
+
+  toSnapshot(): OpenInvoiceSnapshot {
+    return { ...this.props };
+  }
+}
