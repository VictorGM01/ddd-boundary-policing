+import { Injectable } from '@nestjs/common';
+import { OnEvent } from '@nestjs/event-emitter';
+import { BillingEvents, InvoiceIssued } from '@/contracts/billing.events';
+import { VisitsService } from '../application/visits.service';
+
+@Injectable()
+export class BillingEventsListener {
+  constructor(private readonly visits: VisitsService) {}
+
+  @OnEvent(BillingEvents.InvoiceIssued)
+  async onInvoiceIssued(event: InvoiceIssued): Promise<void> {
+    await this.visits.recordOpenInvoice({
+      invoiceId: event.invoiceId,
+      personId: event.personId,
+      issuedAt: new Date(event.issuedAt),
+    });
+  }
+}
diff --git a/src/modules/front-desk/application/visits.service.spec.ts b/src/modules/front-desk/application/visits.service.spec.ts
new file mode 100644
index 0000000..65b2302
--- /dev/null
+++ b/src/modules/front-desk/application/visits.service.spec.ts
@@ -0,0 +1,98 @@
+import { EventEmitter2 } from '@nestjs/event-emitter';
+import { FrontDeskEvents } from '@/contracts/front-desk.events';
+import { FixedClock } from '@/shared-kernel';
+import { OpenInvoiceRecord, OpenInvoiceRepository } from '../domain/open-invoice.repository';
+import { Visit } from '../domain/visit';
+import { OverdueBalanceError } from '../domain/visit.errors';
+import { VisitRepository } from '../domain/visit.repository';
+import { VisitsService } from './visits.service';
+
+class InMemoryVisitRepository extends VisitRepository {
+  readonly items = new Map<string, Visit>();
+
+  async findByAppointmentId(appointmentId: string) {
+    const found = [...this.items.values()].find((v) => v.toSnapshot().appointmentId === appointmentId);
+    return found ? Visit.restore(found.toSnapshot()) : null;
+  }
+
+  async findCheckedIn() {
+    return [...this.items.values()].filter((v) => v.status === 'CHECKED_IN');
+  }
+
+  async save(visit: Visit) {
+    this.items.set(visit.id, Visit.restore(visit.toSnapshot()));
+  }
+}
+
+class InMemoryOpenInvoiceRepository extends OpenInvoiceRepository {
+  readonly items = new Map<string, OpenInvoiceRecord>();
+
+  async save(record: OpenInvoiceRecord) {
+    this.items.set(record.invoiceId, record);
+  }
+
+  async hasIssuedBefore(personId: string, cutoff: Date) {
+    return [...this.items.values()].some((i) => i.personId === personId && i.issuedAt < cutoff);
+  }
+}
+
+describe('VisitsService.checkIn', () => {
+  const now = new Date('2026-04-01T12:00:00Z');
+  let visits: InMemoryVisitRepository;
+  let openInvoices: InMemoryOpenInvoiceRepository;
+  let events: EventEmitter2;
+  let service: VisitsService;
+
+  beforeEach(async () => {
+    visits = new InMemoryVisitRepository();
+    openInvoices = new InMemoryOpenInvoiceRepository();
+    events = new EventEmitter2();
+    service = new VisitsService(visits, openInvoices, new FixedClock(now), events);
+    await service.expectVisitor({
+      appointmentId: 'appt-1',
+      personId: 'person-1',
+      practitionerId: 'dr-1',
+      expectedAt: new Date('2026-04-01T13:00:00Z'),
+    });
+  });
+
+  const invoice = (invoiceId: string, personId: string, issuedAt: string) =>
+    service.recordOpenInvoice({ invoiceId, personId, issuedAt: new Date(issuedAt) });
+
+  it('checks in a visitor without invoices', async () => {
+    const visit = await service.checkIn('appt-1');
+
+    expect(visit.status).toBe('CHECKED_IN');
+  });
+
+  it('refuses the check-in when an open invoice is older than 30 days, leaving the visit and events untouched', async () => {
+    await invoice('inv-1', 'person-1', '2026-03-02T11:59:59Z');
+    const published: unknown[] = [];
+    events.on(FrontDeskEvents.VisitorCheckedIn, (e) => published.push(e));
+
+    await expect(service.checkIn('appt-1')).rejects.toThrow(OverdueBalanceError);
+
+    expect((await visits.findByAppointmentId('appt-1'))?.status).toBe('EXPECTED');
+    expect(published).toEqual([]);
+  });
+
+  it('allows the check-in when the open invoice is exactly 30 days old or newer', async () => {
+    await invoice('inv-1', 'person-1', '2026-03-02T12:00:00Z');
+    await invoice('inv-2', 'person-1', '2026-03-25T12:00:00Z');
+
+    await expect(service.checkIn('appt-1')).resolves.toBeDefined();
+  });
+
+  it('ignores overdue invoices of other people', async () => {
+    await invoice('inv-1', 'person-2', '2026-01-01T00:00:00Z');
+
+    await expect(service.checkIn('appt-1')).resolves.toBeDefined();
+  });
+
+  it('records the same invoice only once', async () => {
+    await invoice('inv-1', 'person-1', '2026-03-25T12:00:00Z');
+    await invoice('inv-1', 'person-1', '2026-03-25T12:00:00Z');
+
+    expect(openInvoices.items.size).toBe(1);
+  });
+});
