@@ -0,0 +1,20 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { OpenInvoiceRecord, OpenInvoiceRepository } from '../domain/open-invoice.repository';
+
+@Injectable()
+export class PrismaOpenInvoiceRepository extends OpenInvoiceRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async save(record: OpenInvoiceRecord): Promise<void> {
+    const { invoiceId, ...data } = record;
+    await this.prisma.frontDeskOpenInvoice.upsert({ where: { invoiceId }, create: record, update: data });
+  }
+
+  async hasIssuedBefore(personId: string, cutoff: Date): Promise<boolean> {
+    const count = await this.prisma.frontDeskOpenInvoice.count({ where: { personId, issuedAt: { lt: cutoff } } });
+    return count > 0;
+  }
+}
