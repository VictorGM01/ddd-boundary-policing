+  noShows: number;
+  feesCents: number;
+}
+
+export abstract class NoShowReportRepository {
+  abstract recordNoShow(input: { appointmentId: string; practitionerId: PractitionerId; startsAt: Date }): Promise<void>;
+  abstract recordFee(input: { appointmentId: string; amountCents: number }): Promise<void>;
