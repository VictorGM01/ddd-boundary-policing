@@ -0,0 +1,24 @@
+import { Injectable } from '@nestjs/common';
+import { OnEvent } from '@nestjs/event-emitter';
+import { BillingEvents, NoShowFeeCharged } from '@/contracts/billing.events';
+import { AppointmentNoShow, SchedulingEvents } from '@/contracts/scheduling.events';
+import { NoShowReportService } from '../application/no-show-report.service';
+
+@Injectable()
+export class ReportingEventsListener {
+  constructor(private readonly report: NoShowReportService) {}
+
+  @OnEvent(SchedulingEvents.AppointmentNoShow)
+  async onAppointmentNoShow(event: AppointmentNoShow): Promise<void> {
+    await this.report.registerNoShow({
+      appointmentId: event.appointmentId,
+      practitionerId: event.practitionerId,
+      startsAt: new Date(event.startsAt),
+    });
+  }
+
+  @OnEvent(BillingEvents.NoShowFeeCharged)
+  async onNoShowFeeCharged(event: NoShowFeeCharged): Promise<void> {
+    await this.report.registerFee({ appointmentId: event.appointmentId, amountCents: event.amountCents });
+  }
+}
