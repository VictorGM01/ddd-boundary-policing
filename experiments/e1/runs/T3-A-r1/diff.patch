@@ -0,0 +1,23 @@
+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { NoShowReportService } from '../application/no-show-report.service';
+
+@Controller('reports')
+export class ReportsController {
+  constructor(private readonly noShowReport: NoShowReportService) {}
+
+  /** Period is [from, to): `from` inclusive, `to` exclusive, matched against the appointment start. */
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const fromDate = new Date(from ?? '');
+    const toDate = new Date(to ?? '');
+    if (Number.isNaN(fromDate.getTime()) || Number.isNaN(toDate.getTime())) {
+      throw new BadRequestException('from and to are required and must be valid ISO 8601 dates');
+    }
+    const rows = await this.noShowReport.byPractitioner(fromDate, toDate);
+    return rows.map(({ practitionerId, noShows, feesCents }) => ({
+      practitionerId,
+      noShows,
+      totalFeesCents: feesCents,
+    }));
+  }
+}
diff --git a/src/modules/reporting/application/no-show-report.service.spec.ts b/src/modules/reporting/application/no-show-report.service.spec.ts
new file mode 100644
index 0000000..c33962f
--- /dev/null
+++ b/src/modules/reporting/application/no-show-report.service.spec.ts
@@ -0,0 +1,72 @@
+import { InvalidReportPeriodError } from '../domain/no-show-report.errors';
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+import { NoShowReportService } from './no-show-report.service';
+
+class InMemoryNoShowReportRepository extends NoShowReportRepository {
+  readonly rows = new Map<string, { practitionerId?: string; startsAt?: Date; feeCents: number }>();
+
+  async recordNoShow({ appointmentId, practitionerId, startsAt }: { appointmentId: string; practitionerId: string; startsAt: Date }) {
+    this.rows.set(appointmentId, { feeCents: 0, ...this.rows.get(appointmentId), practitionerId, startsAt });
+  }
+
+  async recordFee({ appointmentId, amountCents }: { appointmentId: string; amountCents: number }) {
+    this.rows.set(appointmentId, { ...this.rows.get(appointmentId), feeCents: amountCents });
+  }
+
+  async summarize(from: Date, to: Date): Promise<PractitionerNoShowSummary[]> {
+    const byPractitioner = new Map<string, PractitionerNoShowSummary>();
+    for (const row of this.rows.values()) {
+      if (!row.practitionerId || !row.startsAt || row.startsAt < from || row.startsAt >= to) continue;
+      const current = byPractitioner.get(row.practitionerId) ?? {
+        practitionerId: row.practitionerId,
+        noShows: 0,
+        feesCents: 0,
+      };
+      current.noShows += 1;
+      current.feesCents += row.feeCents;
+      byPractitioner.set(row.practitionerId, current);
+    }
+    return [...byPractitioner.values()];
+  }
+}
+
+describe('NoShowReportService', () => {
+  let service: NoShowReportService;
+
+  beforeEach(() => {
+    service = new NoShowReportService(new InMemoryNoShowReportRepository());
+  });
+
+  const period = { from: new Date('2026-03-01T00:00:00Z'), to: new Date('2026-04-01T00:00:00Z') };
+
+  it('counts no-shows and sums fees per practitioner within the period', async () => {
+    await service.registerNoShow({ appointmentId: 'a1', practitionerId: 'dr-1', startsAt: new Date('2026-03-02T10:00:00Z') });
+    await service.registerFee({ appointmentId: 'a1', amountCents: 10_000 });
+    await service.registerNoShow({ appointmentId: 'a2', practitionerId: 'dr-1', startsAt: new Date('2026-03-03T10:00:00Z') });
+    await service.registerFee({ appointmentId: 'a2', amountCents: 10_000 });
+    await service.registerNoShow({ appointmentId: 'a3', practitionerId: 'dr-2', startsAt: new Date('2026-03-04T10:00:00Z') });
+    await service.registerNoShow({ appointmentId: 'a4', practitionerId: 'dr-2', startsAt: new Date('2026-04-01T00:00:00Z') });
+
+    const result = await service.byPractitioner(period.from, period.to);
+
+    expect(result).toEqual([
+      { practitionerId: 'dr-1', noShows: 2, feesCents: 20_000 },
+      { practitionerId: 'dr-2', noShows: 1, feesCents: 0 },
+    ]);
+  });
+
+  it('is independent of the order in which the no-show and the fee arrive, and idempotent', async () => {
+    await service.registerFee({ appointmentId: 'a1', amountCents: 10_000 });
+    await service.registerNoShow({ appointmentId: 'a1', practitionerId: 'dr-1', startsAt: new Date('2026-03-02T10:00:00Z') });
+    await service.registerFee({ appointmentId: 'a1', amountCents: 10_000 });
+
+    expect(await service.byPractitioner(period.from, period.to)).toEqual([
+      { practitionerId: 'dr-1', noShows: 1, feesCents: 10_000 },
+    ]);
+  });
+
+  it('rejects a period that does not start before it ends', async () => {
+    await expect(service.byPractitioner(period.to, period.from)).rejects.toThrow(InvalidReportPeriodError);
+    await expect(service.byPractitioner(period.from, period.from)).rejects.toThrow(InvalidReportPeriodError);
+  });
+});
