@@ -0,0 +1,44 @@
+import { Injectable } from '@nestjs/common';
+import { PrismaService } from '@/infrastructure/prisma/prisma.service';
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+
+// The two events can arrive in either order, so each side upserts only its own columns.
+@Injectable()
+export class PrismaNoShowReportRepository extends NoShowReportRepository {
+  constructor(private readonly prisma: PrismaService) {
+    super();
+  }
+
+  async recordNoShow(input: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void> {
+    const { appointmentId, practitionerId, startsAt } = input;
+    await this.prisma.reportingNoShow.upsert({
+      where: { appointmentId },
+      create: { appointmentId, practitionerId, startsAt },
+      update: { practitionerId, startsAt },
+    });
+  }
+
+  async recordFee(input: { appointmentId: string; amountCents: number }): Promise<void> {
+    const { appointmentId, amountCents } = input;
+    await this.prisma.reportingNoShow.upsert({
+      where: { appointmentId },
+      create: { appointmentId, feeCents: amountCents },
+      update: { feeCents: amountCents },
+    });
+  }
+
+  async summarize(from: Date, to: Date): Promise<PractitionerNoShowSummary[]> {
+    const groups = await this.prisma.reportingNoShow.groupBy({
+      by: ['practitionerId'],
+      where: { practitionerId: { not: null }, startsAt: { gte: from, lt: to } },
+      _count: { _all: true },
+      _sum: { feeCents: true },
+      orderBy: { practitionerId: 'asc' },
+    });
+    return groups.map((g) => ({
+      practitionerId: g.practitionerId as string,
+      noShows: g._count._all,
+      feesCents: g._sum.feeCents ?? 0,
+    }));
+  }
+}
