@@ -0,0 +1,23 @@
+import { Injectable } from '@nestjs/common';
+import { InvalidReportPeriodError } from '../domain/no-show-report.errors';
+import { NoShowReportRepository, PractitionerNoShowSummary } from '../domain/no-show-report.repository';
+
+@Injectable()
+export class NoShowReportService {
+  constructor(private readonly report: NoShowReportRepository) {}
+
+  async registerNoShow(input: { appointmentId: string; practitionerId: string; startsAt: Date }): Promise<void> {
+    await this.report.recordNoShow(input);
+  }
+
+  async registerFee(input: { appointmentId: string; amountCents: number }): Promise<void> {
+    await this.report.recordFee(input);
+  }
+
+  async byPractitioner(from: Date, to: Date): Promise<PractitionerNoShowSummary[]> {
+    if (from >= to) {
+      throw new InvalidReportPeriodError();
+    }
+    return this.report.summarize(from, to);
+  }
+}
