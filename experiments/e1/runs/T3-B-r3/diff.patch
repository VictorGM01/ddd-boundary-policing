+import { BadRequestException, Controller, Get, Query } from '@nestjs/common';
+import { InvoicingService } from '../application/invoicing.service';
+
+@Controller('reports')
+export class NoShowReportController {
+  constructor(private readonly invoicing: InvoicingService) {}
+
+  /** Period is half-open: `from` inclusive, `to` exclusive, both ISO-8601 dates or date-times. */
+  @Get('no-shows')
+  async noShows(@Query('from') from?: string, @Query('to') to?: string) {
+    const report = await this.invoicing.noShowReport(parseDate('from', from), parseDate('to', to));
+    return report.map((row) => ({
+      practitionerId: row.practitionerId,
+      noShows: row.noShows,
+      totalFeesCents: row.feesCents,
+    }));
+  }
+}
+
+function parseDate(name: string, value?: string): Date {
+  if (!value) {
+    throw new BadRequestException(`${name} is required`);
+  }
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    throw new BadRequestException(`${name} must be an ISO-8601 date`);
+  }
+  return date;
+}
