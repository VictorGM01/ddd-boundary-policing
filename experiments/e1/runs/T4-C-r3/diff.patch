@@ -0,0 +1,24 @@
+import type { OpenInvoice } from './open-invoice';
+import { OverdueBalanceError } from './visit.errors';
+
+export const OVERDUE_AFTER_DAYS = 30;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export class VisitorBalance {
+  private constructor(private readonly openInvoices: readonly OpenInvoice[]) {}
+
+  static of(openInvoices: readonly OpenInvoice[]): VisitorBalance {
+    return new VisitorBalance(openInvoices);
+  }
+
+  isOverdue(now: Date): boolean {
+    const cutoff = now.getTime() - OVERDUE_AFTER_DAYS * DAY_MS;
+    return this.openInvoices.some((invoice) => invoice.issuedAt.getTime() < cutoff);
+  }
+
+  assertNotOverdue(now: Date): void {
+    if (this.isOverdue(now)) {
+      throw new OverdueBalanceError(OVERDUE_AFTER_DAYS);
+    }
+  }
+}
