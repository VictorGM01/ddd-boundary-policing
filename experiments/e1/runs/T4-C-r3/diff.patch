+import { VisitorBalance } from './visitor-balance';
+import { OverdueBalanceError } from './visit.errors';
+
+const now = new Date('2026-04-01T12:00:00Z');
+const invoice = (issuedAt: string) => ({ invoiceId: `inv-${issuedAt}`, personId: 'person-1', issuedAt: new Date(issuedAt) });
+
+describe('VisitorBalance', () => {
+  it('is not overdue without open invoices', () => {
+    expect(VisitorBalance.of([]).isOverdue(now)).toBe(false);
+  });
+
+  it('is not overdue when every open invoice is at most 30 days old', () => {
+    const balance = VisitorBalance.of([invoice('2026-03-25T00:00:00Z'), invoice('2026-03-02T12:00:00Z')]);
+
+    expect(balance.isOverdue(now)).toBe(false);
+  });
+
+  it('is overdue when an open invoice is older than 30 days', () => {
+    const balance = VisitorBalance.of([invoice('2026-03-25T00:00:00Z'), invoice('2026-03-02T11:59:59Z')]);
+
+    expect(balance.isOverdue(now)).toBe(true);
+    expect(() => balance.assertNotOverdue(now)).toThrow(OverdueBalanceError);
+  });
+});
